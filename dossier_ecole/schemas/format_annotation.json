{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Format d'annotation humaine — Pipeline ECG",
  "description": "Schéma JSON pour l'annotation humaine des résultats du pipeline RAG Neurosymbolique. Chaque fichier correspond à un cas (1 étudiant × 1 ECG).",
  "type": "object",
  "required": ["_meta", "golden_set", "reponse_etudiant", "pipeline_trace", "annotation_humaine"],
  "properties": {

    "_meta": {
      "type": "object",
      "description": "Métadonnées du cas annoté",
      "required": ["titre", "interet", "difficulte", "date_annotation"],
      "properties": {
        "titre": {
          "type": "string",
          "description": "Titre descriptif du cas"
        },
        "interet": {
          "type": "string",
          "description": "Pourquoi ce cas est intéressant pour l'évaluation"
        },
        "difficulte": {
          "type": "string",
          "description": "Type de difficulté illustrée",
          "examples": ["aucune — cas nominal", "NER — synonyme manquant", "ontologique — raisonnement implicite", "scoring hiérarchique — relation ontologique"]
        },
        "date_annotation": {
          "type": "string",
          "format": "date"
        }
      }
    },

    "golden_set": {
      "type": "object",
      "description": "L'annotation de référence créée par le cardiologue expert",
      "required": ["cas_number", "diagnostic_principal", "annotations_expert", "expected_concepts"],
      "properties": {
        "cas_number": {
          "type": "integer",
          "description": "Numéro du cas ECG (1–15)"
        },
        "category": {
          "type": "string",
          "description": "Catégorie clinique du cas"
        },
        "difficulty": {
          "type": "string"
        },
        "diagnostic_principal": {
          "type": "string"
        },
        "commentaire_correcteur": {
          "type": "string",
          "description": "Commentaire libre du cardiologue expert"
        },
        "annotations_expert": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concept", "category", "role"],
            "properties": {
              "concept": {"type": "string"},
              "category": {
                "type": "string",
                "enum": ["DIAGNOSTIC_URGENT", "DIAGNOSTIC_MAJEUR", "SIGNE_ECG_PATHOLOGIQUE", "DESCRIPTEUR_ECG"]
              },
              "role": {
                "type": "string",
                "enum": ["🎯 Diagnostic validant", "📝 Description"]
              },
              "poids_ontologie": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            }
          }
        },
        "expected_concepts": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Liste des concepts validants que l'étudiant doit identifier"
        }
      }
    },

    "reponse_etudiant": {
      "type": "object",
      "required": ["code", "texte_brut"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Code anonyme de l'étudiant (ex: ECG-84SV)"
        },
        "texte_brut": {
          "type": "string",
          "description": "Réponse de l'étudiant telle qu'elle a été saisie"
        },
        "commentaire": {
          "type": "string",
          "description": "Commentaire de l'annotateur sur la réponse"
        }
      }
    },

    "pipeline_trace": {
      "type": "object",
      "description": "Trace complète de l'exécution du pipeline",
      "properties": {
        "etape_1_ner": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "termes_extraits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "terme_brut": {"type": "string"},
                  "note": {"type": "string"}
                }
              }
            }
          }
        },
        "etape_2_matching": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "concepts_resolus": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["terme_brut", "ontology_id", "method", "statut"],
                "properties": {
                  "terme_brut": {"type": "string"},
                  "ontology_id": {"type": "string"},
                  "concept_name": {"type": "string"},
                  "method": {
                    "type": "string",
                    "enum": ["coupe_circuit", "juge_llm"]
                  },
                  "statut": {
                    "type": "string",
                    "enum": ["present", "absent", "hypothese"]
                  },
                  "justification": {"type": "string"}
                }
              }
            }
          }
        },
        "etape_3_scoring": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "validant_details": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["golden_name", "golden_id", "found", "score_pct", "match_type"],
                "properties": {
                  "golden_name": {"type": "string"},
                  "golden_id": {"type": "string"},
                  "found": {"type": "boolean"},
                  "score_pct": {"type": "number"},
                  "match_type": {
                    "type": "string",
                    "enum": ["exact", "child_gen1", "child_gen2", "child_gen3", "parent_gen1", "parent_gen2", "parent_gen3", "missing"]
                  },
                  "found_via_name": {"type": "string"},
                  "explication": {"type": "string"}
                }
              }
            },
            "score_final_pct": {"type": "number"}
          }
        }
      }
    },

    "annotation_humaine": {
      "type": "object",
      "description": "L'annotation humaine qui évalue la qualité du pipeline",
      "required": ["verdict_global", "commentaire_global", "annotations_par_concept"],
      "properties": {
        "verdict_global": {
          "type": "string",
          "enum": ["OK", "PARTIEL", "ERREUR"],
          "description": "OK = pipeline correct, PARTIEL = score acceptable mais imparfait, ERREUR = pipeline se trompe"
        },
        "commentaire_global": {
          "type": "string"
        },
        "annotations_par_concept": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concept_attendu", "verdict"],
            "properties": {
              "concept_attendu": {"type": "string"},
              "verdict": {
                "type": "string",
                "enum": ["OK", "ERREUR", "PARTIEL"]
              },
              "score_pipeline": {"type": "number"},
              "score_humain_attendu": {"type": "number"},
              "type_erreur": {
                "type": ["string", "null"],
                "enum": [null, "NER_FAIL", "MATCHING_FAIL", "SYNONYME_MANQUANT", "IMPLICITE", "POIDS_GUARD", "HALLUCINATION_LLM"],
                "description": "Type d'erreur si verdict != OK"
              },
              "commentaire": {"type": "string"},
              "pourquoi_manque": {"type": "string"},
              "correction_proposee": {"type": "string"}
            }
          }
        }
      }
    },

    "piste_amelioration": {
      "type": "object",
      "description": "Piste d'amélioration suggérée par ce cas",
      "properties": {
        "titre": {"type": "string"},
        "description": {"type": "string"},
        "difficulte_technique": {"type": "string"},
        "impact": {"type": "string"}
      }
    }
  }
}
